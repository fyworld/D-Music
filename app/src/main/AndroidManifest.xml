<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 后台播放需要的前台服务权限（Android 9+ 强制要求声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 强制要求按用途声明前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ 运行时申请，用于显示媒体通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 防止后台播放时 CPU 休眠，保证音频流稳定 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 9 及以下：直接写公共 Music 目录需要写存储权限（10+ 走 MediaStore 无需） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 读取公共媒体库（扫描本地歌曲/播放本地文件）：10-12 用 READ_EXTERNAL_STORAGE -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+：细分媒体读取权限（音频） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 11+：所有文件访问（用户在系统设置开启一次后，
         删除/重命名他建文件不再弹系统授权框，完全静默） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- v1.4.19：应用内更新——下载 APK 后拉起系统安装器（Android 8+ 需此权限，
         用户在「安装未知应用」设置中授予本 App 后才能安装） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ 包可见性：打赏页拉起微信需要声明（否则
         getLaunchIntentForPackage 返回 null，微信装了也"看不见"） -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:name=".SolaraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Solara">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- v1.4.19：应用内更新——APK 安装用的 FileProvider（Android 7+ content URI） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>